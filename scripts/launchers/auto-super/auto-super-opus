#!/usr/bin/env bash
# auto-super-opus — start (or resume) an auto-super run as a systemd-user service
# so it survives Claude session boundaries, terminal exits, and SIGTERM cleanups
# that have repeatedly killed runs launched from tmux.
#
# Usage:
#   auto-super-opus bitino /tmp/bitino-super-prompt.txt
#       --flags "--with-audit"
#       [--resume <super-run-id>] [--audit-run <audit-run-id>]
#       [--model <model>]   # default: opus (latest installed Opus)
#       [--repo <path>]     # default: /home/r/Coding/<instance>
#
# Examples:
#   auto-super-opus bitino /tmp/bitino-super-prompt.txt --flags '--with-audit'
#   auto-super-opus autonomy /tmp/autonomy-super-prompt.txt \
#       --flags '--skip-design --with-audit' \
#       --resume /home/r/Coding/autonomy/.auto/super/20260512-165419 \
#       --audit-run 20260512-190636
#
# Tail logs:  journalctl --user -fu auto-super@<instance>.service
#             tail -f /home/r/.local/state/auto-super/<instance>.log
# Stop:      systemctl --user stop auto-super@<instance>.service
# Status:    systemctl --user status auto-super@<instance>.service

set -euo pipefail

instance="${1:-}"
prompt_path="${2:-}"

if [[ -z "$instance" || -z "$prompt_path" ]]; then
    sed -n '2,25p' "$0"
    exit 2
fi
shift 2

flags=""
resume=""
audit_run=""
model="opus"
repo=""

while (( $# )); do
    case "$1" in
        --flags) flags="$2"; shift 2 ;;
        --resume) resume="$2"; shift 2 ;;
        --audit-run) audit_run="$2"; shift 2 ;;
        --model) model="$2"; shift 2 ;;
        --repo) repo="$2"; shift 2 ;;
        *) echo "unknown arg: $1" >&2; exit 2 ;;
    esac
done

repo="${repo:-/home/r/Coding/$instance}"

if [[ ! -d "$repo" ]]; then
    echo "auto-super-opus: repo not found: $repo" >&2
    exit 2
fi
if [[ ! -f "$prompt_path" ]]; then
    echo "auto-super-opus: prompt file not found: $prompt_path" >&2
    exit 2
fi

mkdir -p /home/r/.config/auto-super /home/r/.local/state/auto-super
env_file="/home/r/.config/auto-super/${instance}.env"

cat > "$env_file" <<EOF
# Generated by auto-super-opus at $(date -Iseconds).
# Edit and run \`systemctl --user restart auto-super@${instance}.service\` to apply.
AUTO_SUPER_REPO=$repo
AUTO_SUPER_PROMPT=$prompt_path
AUTO_SUPER_MODEL=$model
AUTO_SUPER_FLAGS='$flags'
AUTO_SUPER_RESUME='$resume'
AUTO_SUPER_AUDIT_RUN='$audit_run'
EOF

echo "wrote $env_file"
cat "$env_file"
echo

systemctl --user daemon-reload
systemctl --user enable --now "auto-super@${instance}.service"
systemctl --user status "auto-super@${instance}.service" --no-pager -l | head -20 || true

cat <<EOF

tail logs:  journalctl --user -fu auto-super@${instance}.service
            tail -f /home/r/.local/state/auto-super/${instance}.log
stop:       systemctl --user stop auto-super@${instance}.service
restart:    systemctl --user restart auto-super@${instance}.service
EOF
