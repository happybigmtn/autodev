#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  pilot-dev <repo-slug> "<operator intent>"

Environment:
  PILOT_PLAN=/path/to/plan.md       Optional authoritative plan file.
  PILOT_RUN_ID=...                  Optional deterministic run id.
  PILOT_FOCUS="..."                 Optional autodev focus override.
  PILOT_MODEL=gpt-5.5               Codex/autodev model hint.
  PILOT_EFFORT=high                 Codex/autodev work effort hint.
  PILOT_PLAN_EFFORT=xhigh           Autodev planning effort hint.
  PILOT_THREADS=3                   Autodev worker lane hint.
  PILOT_PLANNING_MODE=auto           auto, greenfield, steward, full, or none.
  PILOT_REQUIRE_PLANNING_SPINE=1      Require auto corpus + auto gen --snapshot-only.
  PILOT_REFERENCE_REPOS="..."        Optional whitespace-separated reference repo roots.
  PILOT_AUTODEV_SOURCE=/srv/dev/repos/autodev
                                      Local autodev source used to refresh stale auto.
  PILOT_AUTODEV_AUTOINSTALL=1         Install current local autodev source when auto is stale.
  PILOT_AUTODEV_INSTALL_ROOT=$HOME/.local
  PILOT_TYPED_PREFLIGHT=1             Use typed `auto pilot --preflight-only`
                                      for the artifact spine when available.
  PILOT_TYPED_PLANNING=1              Use typed `auto pilot --planning-only`
                                      for doctor/corpus/gen/steward planning.
  PILOT_TYPED_EXECUTION_MANIFEST=1    Use typed `auto pilot --execution-manifest-only`
                                      before Codex execution.
  PILOT_TYPED_TASK_FINALIZE=1          Run typed `auto pilot --task-finalize-only`
                                      after successful Codex execution when
                                      the execution manifest selected a task.
  PILOT_TASK_FINALIZE_STATUS=auto      auto, done, or partial. auto maps
                                      executed->done and degraded->partial.
  PILOT_TASK_FINALIZE_COMMIT=1         Commit source-plan task-state changes.
  PILOT_TASK_FINALIZE_PUSH=auto        auto, 1, or 0. auto pushes only when the
                                      execution manifest says the implementation
                                      was pushed on a normal-origin repo.
  PILOT_TYPED_CLOSEOUT=1              Use typed `auto pilot --closeout-only`
                                      after Codex execution.
  PILOT_PROJECT_ROLLUP=1              Write `project-rollup.json/md` after
                                      successful typed closeout.
  PILOT_GBRAIN_PROJECT_ROLLUP=1       Publish `project-rollup.md` to
                                      `projects/<repo-slug>` in gbrain.
  PILOT_WRAPPER_PREFLIGHT_ONLY=0      Stop after wrapper preflight/planning
                                      gates; useful for no-Codex smoke tests.

This command is intended to be called by Hermes. It supervises a Codex worker
instead of trying to do repo execution inside Hermes itself.
USAGE
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if [[ $# -lt 2 ]]; then
  usage >&2
  exit 2
fi

REPO_SLUG="$1"
shift
PROMPT="$*"

BASE_DIR="${PILOT_BASE_DIR:-/srv/dev/repos}"
REPO="$BASE_DIR/$REPO_SLUG"
RUN_ID="${PILOT_RUN_ID:-$(date -u +%Y%m%dT%H%M%SZ)-$REPO_SLUG}"

if [[ -d "$REPO" ]]; then
  WORKDIR="$REPO"
  RUN_ROOT="$REPO/.auto/orchestrator/$RUN_ID"
else
  WORKDIR="$BASE_DIR"
  RUN_ROOT="${PILOT_RUN_ROOT:-/home/dev/orchestrator-runs/$RUN_ID}"
fi

MODEL="${PILOT_MODEL:-gpt-5.5}"
EFFORT="${PILOT_EFFORT:-high}"
PLAN_EFFORT="${PILOT_PLAN_EFFORT:-xhigh}"
THREADS="${PILOT_THREADS:-3}"
FOCUS="${PILOT_FOCUS:-prove Hermes/gbrain/autodev/Codex/Claude orchestration with supervised Codex workers}"
PLAN_PATH="${PILOT_PLAN:-}"
PLANNING_MODE="${PILOT_PLANNING_MODE:-auto}"
REQUIRE_PLANNING_SPINE="${PILOT_REQUIRE_PLANNING_SPINE:-1}"
REFERENCE_REPOS="${PILOT_REFERENCE_REPOS:-}"
AUTODEV_SOURCE="${PILOT_AUTODEV_SOURCE:-/srv/dev/repos/autodev}"
AUTODEV_AUTOINSTALL="${PILOT_AUTODEV_AUTOINSTALL:-1}"
AUTODEV_INSTALL_ROOT="${PILOT_AUTODEV_INSTALL_ROOT:-$HOME/.local}"
TYPED_PREFLIGHT="${PILOT_TYPED_PREFLIGHT:-1}"
TYPED_PREFLIGHT_REQUIRED="${PILOT_TYPED_PREFLIGHT_REQUIRED:-0}"
TYPED_PLANNING="${PILOT_TYPED_PLANNING:-1}"
TYPED_PLANNING_REQUIRED="${PILOT_TYPED_PLANNING_REQUIRED:-0}"
TYPED_EXECUTION_MANIFEST="${PILOT_TYPED_EXECUTION_MANIFEST:-1}"
TYPED_EXECUTION_MANIFEST_REQUIRED="${PILOT_TYPED_EXECUTION_MANIFEST_REQUIRED:-0}"
TYPED_TASK_FINALIZE="${PILOT_TYPED_TASK_FINALIZE:-1}"
TYPED_TASK_FINALIZE_REQUIRED="${PILOT_TYPED_TASK_FINALIZE_REQUIRED:-0}"
TASK_FINALIZE_STATUS_REQUEST="${PILOT_TASK_FINALIZE_STATUS:-auto}"
TASK_FINALIZE_COMMIT="${PILOT_TASK_FINALIZE_COMMIT:-1}"
TASK_FINALIZE_PUSH="${PILOT_TASK_FINALIZE_PUSH:-auto}"
TYPED_CLOSEOUT="${PILOT_TYPED_CLOSEOUT:-1}"
TYPED_CLOSEOUT_REQUIRED="${PILOT_TYPED_CLOSEOUT_REQUIRED:-0}"
PROJECT_ROLLUP="${PILOT_PROJECT_ROLLUP:-1}"
PROJECT_ROLLUP_REQUIRED="${PILOT_PROJECT_ROLLUP_REQUIRED:-0}"
GBRAIN_PROJECT_ROLLUP="${PILOT_GBRAIN_PROJECT_ROLLUP:-1}"
WRAPPER_PREFLIGHT_ONLY="${PILOT_WRAPPER_PREFLIGHT_ONLY:-0}"
MIN_DISK_KB="${PILOT_MIN_DISK_KB:-10000000}"
TYPED_PREFLIGHT_RAN=0
TYPED_PLANNING_RAN=0
TYPED_EXECUTION_MANIFEST_RAN=0
TYPED_TASK_FINALIZE_RAN=0
TYPED_CLOSEOUT_RAN=0
TASK_FINALIZE_STATUS="skipped"
REMOTE_SYNC_MODE="normal"
CURRENT_BRANCH="unknown"

REFERENCE_ARGS=()
if [[ -n "$REFERENCE_REPOS" ]]; then
  read -r -a REFERENCE_ARGS_RAW <<< "$REFERENCE_REPOS"
  for ref in "${REFERENCE_ARGS_RAW[@]}"; do
    REFERENCE_ARGS+=(--reference-repo "$ref")
  done
fi

if [[ -d "$REPO/.git" ]] && ! git -C "$REPO" remote get-url origin >/dev/null 2>&1; then
  export AUTO_SKIP_REMOTE_SYNC="${AUTO_SKIP_REMOTE_SYNC:-1}"
  REMOTE_SYNC_MODE="local-no-origin"
fi

if [[ -d "$WORKDIR/.git" ]]; then
  CURRENT_BRANCH="$(git -C "$WORKDIR" branch --show-current 2>/dev/null || true)"
  CURRENT_BRANCH="${CURRENT_BRANCH:-detached}"
fi

mkdir -p "$RUN_ROOT"/{gbrain,codex,logs}

send_telegram() {
  local subject="$1"
  local body="$2"
  if command -v hermes >/dev/null 2>&1; then
    printf '%s\n' "$body" | hermes send --to telegram --subject "$subject" --file - >/dev/null 2>&1 || true
  fi
}


write_phase() {
  local phase="$1"
  local status="${2:-running}"
  local detail="${3:-}"
  local artifact="${4:-}"
  local updated_at
  updated_at="$(date -u +%FT%TZ)"
  {
    echo "current_phase=$phase"
    echo "current_phase_status=$status"
    echo "current_phase_updated_at=$updated_at"
    if [[ -n "$artifact" ]]; then
      echo "current_phase_artifact=$artifact"
    fi
  } > "$RUN_ROOT/phase.env"
  if command -v python3 >/dev/null 2>&1; then
    python3 - "$RUN_ROOT/phase-heartbeat.json" "$RUN_ROOT/phase-history.jsonl" "$RUN_ID" "$REPO_SLUG" "$WORKDIR" "$phase" "$status" "$detail" "$artifact" "$updated_at" <<'PY_PHASE' || true
import json
import os
import sys
from pathlib import Path

heartbeat_path = Path(sys.argv[1])
history_path = Path(sys.argv[2])
entry = {
    "schema_version": 1,
    "run_id": sys.argv[3],
    "repo": sys.argv[4],
    "workdir": sys.argv[5],
    "phase": sys.argv[6],
    "status": sys.argv[7],
    "detail": sys.argv[8],
    "artifact": sys.argv[9],
    "updated_at": sys.argv[10],
    "pid": os.getpid(),
}
heartbeat_path.parent.mkdir(parents=True, exist_ok=True)
tmp = heartbeat_path.with_suffix(heartbeat_path.suffix + ".tmp")
tmp.write_text(json.dumps(entry, sort_keys=True, indent=2) + "\n", encoding="utf-8")
tmp.replace(heartbeat_path)
with history_path.open("a", encoding="utf-8") as handle:
    handle.write(json.dumps(entry, sort_keys=True) + "\n")
PY_PHASE
  fi
}

fail_orchestration() {
  local code="$1"
  shift
  write_phase "failed" "failed" "exit $code" "$RUN_ROOT/orchestration-failure.md"
  {
    echo "# Orchestration Failure"
    echo
    printf '%s\n' "$@"
  } > "$RUN_ROOT/orchestration-failure.md"
  send_telegram "[pilot-dev]" "failed $REPO_SLUG
run: $RUN_ID
status: $code
failure: $RUN_ROOT/orchestration-failure.md"
  exit "$code"
}

auto_version_commit() {
  command -v auto >/dev/null 2>&1 || return 1
  auto --version 2>/dev/null | awk '/^commit:/ { print $2; exit }'
}

{
  echo "repo_slug=$REPO_SLUG"
  echo "repo=$REPO"
  echo "workdir=$WORKDIR"
  echo "run_id=$RUN_ID"
  echo "run_root=$RUN_ROOT"
  echo "prompt=$PROMPT"
  echo "focus=$FOCUS"
  echo "model=$MODEL"
  echo "effort=$EFFORT"
  echo "plan_effort=$PLAN_EFFORT"
  echo "threads=$THREADS"
  echo "plan_path=${PLAN_PATH:-none}"
  echo "planning_mode=$PLANNING_MODE"
  echo "require_planning_spine=$REQUIRE_PLANNING_SPINE"
  echo "reference_repos=${REFERENCE_REPOS:-none}"
  echo "autodev_source=$AUTODEV_SOURCE"
  echo "autodev_autoinstall=$AUTODEV_AUTOINSTALL"
  echo "autodev_install_root=$AUTODEV_INSTALL_ROOT"
  echo "typed_preflight_requested=$TYPED_PREFLIGHT"
  echo "typed_preflight_required=$TYPED_PREFLIGHT_REQUIRED"
  echo "typed_planning_requested=$TYPED_PLANNING"
  echo "typed_planning_required=$TYPED_PLANNING_REQUIRED"
  echo "typed_execution_manifest_requested=$TYPED_EXECUTION_MANIFEST"
  echo "typed_execution_manifest_required=$TYPED_EXECUTION_MANIFEST_REQUIRED"
  echo "typed_task_finalize_requested=$TYPED_TASK_FINALIZE"
  echo "typed_task_finalize_required=$TYPED_TASK_FINALIZE_REQUIRED"
  echo "task_finalize_status_request=$TASK_FINALIZE_STATUS_REQUEST"
  echo "task_finalize_commit=$TASK_FINALIZE_COMMIT"
  echo "task_finalize_push=$TASK_FINALIZE_PUSH"
  echo "typed_closeout_requested=$TYPED_CLOSEOUT"
  echo "typed_closeout_required=$TYPED_CLOSEOUT_REQUIRED"
  echo "project_rollup_requested=$PROJECT_ROLLUP"
  echo "project_rollup_required=$PROJECT_ROLLUP_REQUIRED"
  echo "gbrain_project_rollup=$GBRAIN_PROJECT_ROLLUP"
  echo "wrapper_preflight_only=$WRAPPER_PREFLIGHT_ONLY"
  echo "min_disk_kb=$MIN_DISK_KB"
  echo "remote_sync_mode=$REMOTE_SYNC_MODE"
  echo "current_branch=$CURRENT_BRANCH"
  echo "AUTO_SKIP_REMOTE_SYNC=${AUTO_SKIP_REMOTE_SYNC:-}"
  echo "created=$(date -u +%FT%TZ)"
} > "$RUN_ROOT/run.env"
write_phase "initialized" "running" "pilot-dev initialized" "$RUN_ROOT/run.env"

AUTODEV_SOURCE_HEAD=""
if [[ -d "$AUTODEV_SOURCE/.git" && -f "$AUTODEV_SOURCE/Cargo.toml" ]]; then
  AUTODEV_SOURCE_HEAD="$(git -C "$AUTODEV_SOURCE" rev-parse --short HEAD 2>/dev/null || true)"
fi
AUTODEV_INSTALLED_BEFORE="$(auto_version_commit || true)"
{
  echo "autodev_source_head=${AUTODEV_SOURCE_HEAD:-unknown}"
  echo "autodev_installed_commit_before=${AUTODEV_INSTALLED_BEFORE:-missing}"
} >> "$RUN_ROOT/run.env"

if [[ -n "$AUTODEV_SOURCE_HEAD" && "${AUTODEV_INSTALLED_BEFORE:-}" != "$AUTODEV_SOURCE_HEAD" ]]; then
  if [[ "$AUTODEV_AUTOINSTALL" != "1" ]]; then
    fail_orchestration 79 \
      "Installed \`auto\` is stale and \`PILOT_AUTODEV_AUTOINSTALL\` is disabled." \
      "" \
      "Expected autodev source commit: \`$AUTODEV_SOURCE_HEAD\`" \
      "Installed auto commit: \`${AUTODEV_INSTALLED_BEFORE:-missing}\`" \
      "Source: \`$AUTODEV_SOURCE\`"
  fi
  write_phase "autodev-install" "running" "install current autodev source" "$RUN_ROOT/logs/autodev-install.log"
  (
    cd "$AUTODEV_SOURCE"
    PATH="$HOME/.cargo/bin:$HOME/.rustup/toolchains/stable-x86_64-unknown-linux-gnu/bin:/home/dev/.cargo/bin:/home/dev/.rustup/toolchains/stable-x86_64-unknown-linux-gnu/bin:$PATH" \
      cargo install --path . --locked --root "$AUTODEV_INSTALL_ROOT"
  ) > "$RUN_ROOT/logs/autodev-install.log" 2>&1 || fail_orchestration 79 \
      "Failed to install current autodev source before running pilot-dev." \
      "" \
      "Source: \`$AUTODEV_SOURCE\`" \
      "Log: \`$RUN_ROOT/logs/autodev-install.log\`"
  hash -r || true
  write_phase "autodev-install" "ok" "installed current autodev source" "$RUN_ROOT/logs/autodev-install.log"
fi

AUTODEV_INSTALLED_AFTER="$(auto_version_commit || true)"
echo "autodev_installed_commit_after=${AUTODEV_INSTALLED_AFTER:-missing}" >> "$RUN_ROOT/run.env"
if [[ -n "$AUTODEV_SOURCE_HEAD" && "${AUTODEV_INSTALLED_AFTER:-}" != "$AUTODEV_SOURCE_HEAD" ]]; then
  fail_orchestration 79 \
    "Installed \`auto\` still does not match local autodev source after refresh." \
    "" \
    "Expected autodev source commit: \`$AUTODEV_SOURCE_HEAD\`" \
    "Installed auto commit: \`${AUTODEV_INSTALLED_AFTER:-missing}\`" \
    "Source: \`$AUTODEV_SOURCE\`" \
    "Install log: \`$RUN_ROOT/logs/autodev-install.log\`"
fi

if [[ -z "${AUTODEV_INSTALLED_AFTER:-}" && -z "$AUTODEV_SOURCE_HEAD" ]]; then
  fail_orchestration 79 \
    "No usable \`auto\` binary and no local autodev source were found." \
    "" \
    "Expected binary: \`auto\` in PATH" \
    "Expected source: \`$AUTODEV_SOURCE\`"
fi

if [[ "$TYPED_PREFLIGHT" == "1" ]] && command -v auto >/dev/null 2>&1 && auto pilot --help >/dev/null 2>&1; then
  TYPED_PILOT_MODE_FLAG="--preflight-only"
  TYPED_PILOT_PHASE="preflight"
  TYPED_PILOT_LOG="$RUN_ROOT/logs/auto-pilot-preflight.log"
  if [[ "$TYPED_PLANNING" == "1" ]]; then
    TYPED_PILOT_MODE_FLAG="--planning-only"
    TYPED_PILOT_PHASE="planning"
    TYPED_PILOT_LOG="$RUN_ROOT/logs/auto-pilot-planning.log"
  fi
  TYPED_PREFLIGHT_ARGS=(
    pilot
    "$REPO_SLUG"
    "$PROMPT"
    --base-dir "$BASE_DIR"
    --run-id "$RUN_ID"
    --run-root "$RUN_ROOT"
    --autodev-source "$AUTODEV_SOURCE"
    --min-disk-kb "$MIN_DISK_KB"
    --focus "$FOCUS"
    --model "$MODEL"
    --effort "$EFFORT"
    --plan-effort "$PLAN_EFFORT"
    --threads "$THREADS"
    --planning-mode "$PLANNING_MODE"
    "$TYPED_PILOT_MODE_FLAG"
  )
  if [[ "$REMOTE_SYNC_MODE" == "local-no-origin" ]]; then
    TYPED_PREFLIGHT_ARGS+=(--allow-local-only)
  fi
  if [[ "$REQUIRE_PLANNING_SPINE" == "0" ]]; then
    TYPED_PREFLIGHT_ARGS+=(--require-planning-spine false)
  fi
  if [[ -n "$PLAN_PATH" ]]; then
    TYPED_PREFLIGHT_ARGS+=(--plan "$PLAN_PATH")
  fi
  TYPED_PREFLIGHT_ARGS+=("${REFERENCE_ARGS[@]}")

  write_phase "$TYPED_PILOT_PHASE" "running" "auto pilot $TYPED_PILOT_MODE_FLAG" "$TYPED_PILOT_LOG"
  if (
    cd "$WORKDIR"
    auto "${TYPED_PREFLIGHT_ARGS[@]}"
  ) > "$TYPED_PILOT_LOG" 2>&1; then
    TYPED_PREFLIGHT_RAN=1
    if [[ "$TYPED_PILOT_PHASE" == "planning" ]]; then
      TYPED_PLANNING_RAN=1
    fi
    write_phase "$TYPED_PILOT_PHASE" "ok" "auto pilot $TYPED_PILOT_MODE_FLAG" "$TYPED_PILOT_LOG"
    {
      echo "autodev_source_head=${AUTODEV_SOURCE_HEAD:-unknown}"
      echo "autodev_installed_commit_before=${AUTODEV_INSTALLED_BEFORE:-missing}"
      echo "autodev_installed_commit_after=${AUTODEV_INSTALLED_AFTER:-missing}"
      echo "typed_preflight_ran=1"
      echo "typed_planning_ran=$TYPED_PLANNING_RAN"
      echo "typed_pilot_phase=$TYPED_PILOT_PHASE"
      echo "typed_pilot_log=$TYPED_PILOT_LOG"
    } >> "$RUN_ROOT/run.env"
  else
    write_phase "$TYPED_PILOT_PHASE" "failed" "auto pilot $TYPED_PILOT_MODE_FLAG" "$TYPED_PILOT_LOG"
    {
      echo "typed_preflight_ran=0"
      echo "typed_planning_ran=0"
      echo "typed_pilot_phase=$TYPED_PILOT_PHASE"
      echo "typed_pilot_error_log=$TYPED_PILOT_LOG"
    } >> "$RUN_ROOT/run.env"
    if [[ "$TYPED_PREFLIGHT_REQUIRED" == "1" || ( "$TYPED_PILOT_PHASE" == "planning" && "$TYPED_PLANNING_REQUIRED" == "1" ) ]]; then
      fail_orchestration 80 \
        "Typed \`auto pilot $TYPED_PILOT_MODE_FLAG\` failed and typed pilot was required." \
        "" \
        "Log: \`$TYPED_PILOT_LOG\`"
    fi
  fi
else
  echo "typed_preflight_ran=0" >> "$RUN_ROOT/run.env"
  echo "typed_planning_ran=0" >> "$RUN_ROOT/run.env"
fi

if [[ "$TYPED_EXECUTION_MANIFEST" == "1" ]] && command -v auto >/dev/null 2>&1 && auto pilot --help >/dev/null 2>&1; then
  TYPED_EXECUTION_MANIFEST_ARGS=(
    pilot
    "$REPO_SLUG"
    "$PROMPT"
    --base-dir "$BASE_DIR"
    --run-id "$RUN_ID"
    --run-root "$RUN_ROOT"
    --autodev-source "$AUTODEV_SOURCE"
    --min-disk-kb "$MIN_DISK_KB"
    --focus "$FOCUS"
    --model "$MODEL"
    --effort "$EFFORT"
    --plan-effort "$PLAN_EFFORT"
    --threads "$THREADS"
    --planning-mode "$PLANNING_MODE"
    --execution-manifest-only
  )
  if [[ "$REMOTE_SYNC_MODE" == "local-no-origin" ]]; then
    TYPED_EXECUTION_MANIFEST_ARGS+=(--allow-local-only)
  fi
  if [[ "$REQUIRE_PLANNING_SPINE" == "0" ]]; then
    TYPED_EXECUTION_MANIFEST_ARGS+=(--require-planning-spine false)
  fi
  if [[ -n "$PLAN_PATH" ]]; then
    TYPED_EXECUTION_MANIFEST_ARGS+=(--plan "$PLAN_PATH")
  fi
  TYPED_EXECUTION_MANIFEST_ARGS+=("${REFERENCE_ARGS[@]}")

  write_phase "execution-manifest" "running" "auto pilot --execution-manifest-only" "$RUN_ROOT/logs/auto-pilot-execution-manifest.log"
  if (
    cd "$WORKDIR"
    auto "${TYPED_EXECUTION_MANIFEST_ARGS[@]}"
  ) > "$RUN_ROOT/logs/auto-pilot-execution-manifest.log" 2>&1; then
    TYPED_EXECUTION_MANIFEST_RAN=1
    write_phase "execution-manifest" "ok" "auto pilot --execution-manifest-only" "$RUN_ROOT/logs/auto-pilot-execution-manifest.log"
    {
      echo "typed_execution_manifest_ran=1"
      echo "typed_execution_manifest_status=ok"
      echo "typed_execution_manifest_log=$RUN_ROOT/logs/auto-pilot-execution-manifest.log"
    } >> "$RUN_ROOT/run.env"
  else
    write_phase "execution-manifest" "failed" "auto pilot --execution-manifest-only" "$RUN_ROOT/logs/auto-pilot-execution-manifest.log"
    {
      echo "typed_execution_manifest_ran=0"
      echo "typed_execution_manifest_status=failed"
      echo "typed_execution_manifest_log=$RUN_ROOT/logs/auto-pilot-execution-manifest.log"
    } >> "$RUN_ROOT/run.env"
    if [[ "$TYPED_EXECUTION_MANIFEST_REQUIRED" == "1" ]]; then
      fail_orchestration 81 \
        "Typed \`auto pilot --execution-manifest-only\` failed and typed execution manifest was required." \
        "" \
        "Log: \`$RUN_ROOT/logs/auto-pilot-execution-manifest.log\`"
    fi
  fi
else
  echo "typed_execution_manifest_ran=0" >> "$RUN_ROOT/run.env"
fi

send_telegram "[pilot-dev]" "starting $REPO_SLUG
run: $RUN_ID
workdir: $WORKDIR
intent: $PROMPT"

if [[ "$TYPED_PREFLIGHT_RAN" != "1" ]] && command -v auto >/dev/null 2>&1; then
  write_phase "command-surface" "running" "inventory auto command surface" "$RUN_ROOT/autodev-command-selection.md"
  auto --version > "$RUN_ROOT/logs/auto-version.log" 2>&1 || true
  auto --help > "$RUN_ROOT/logs/auto-help.log" 2>&1 || true
  if auto command-surface --json > "$RUN_ROOT/logs/auto-command-surface.json" 2>/dev/null && command -v jq >/dev/null 2>&1; then
    jq -r '.commands[].name' "$RUN_ROOT/logs/auto-command-surface.json" > "$RUN_ROOT/logs/auto-commands.txt" || true
  else
    rm -f "$RUN_ROOT/logs/auto-command-surface.json"
    awk '
      /^Commands:/ { in_commands=1; next }
      in_commands && /^Options:/ { in_commands=0 }
      in_commands && $1 ~ /^[[:alnum:]-]+$/ { print $1 }
    ' "$RUN_ROOT/logs/auto-help.log" > "$RUN_ROOT/logs/auto-commands.txt" || true
  fi

  if [[ -s "$RUN_ROOT/logs/auto-commands.txt" ]]; then
    while IFS= read -r cmd; do
      [[ -z "$cmd" ]] && continue
      auto "$cmd" --help > "$RUN_ROOT/logs/auto-help-$cmd.log" 2>&1 || true
    done < "$RUN_ROOT/logs/auto-commands.txt"

    if [[ -s "$RUN_ROOT/logs/auto-command-surface.json" ]] && command -v jq >/dev/null 2>&1; then
      jq \
        --arg run_id "$RUN_ID" \
        --arg repo "$REPO_SLUG" \
        '{
          schema_version: 1,
          run_id: $run_id,
          repo: $repo,
          source: "auto command-surface --json",
          commands: [
            .commands[] as $cmd | {
              name: $cmd.name,
              about: ($cmd.about // ""),
              usage: ($cmd.usage // ""),
              command: ("auto " + $cmd.name),
              decision: "UNDECIDED",
              reason: "",
              subcommands: [
                $cmd.subcommands[]? as $sub | {
                  name: $sub.name,
                  about: ($sub.about // ""),
                  usage: ($sub.usage // ""),
                  command: ("auto " + $cmd.name + " " + $sub.name),
                  decision: "UNDECIDED",
                  reason: "",
                  subcommands: [
                    $sub.subcommands[]? as $nested | {
                      name: $nested.name,
                      about: ($nested.about // ""),
                      usage: ($nested.usage // ""),
                      command: ("auto " + $cmd.name + " " + $sub.name + " " + $nested.name),
                      decision: "UNDECIDED",
                      reason: ""
                    }
                  ]
                }
              ],
              actions: [
                $cmd.arguments[]?
                | select(.id == "action")
                | .possible_values[]? as $action
                | {
                  name: $action.name,
                  help: ($action.help // ""),
                  command: ("auto " + $cmd.name + " " + $action.name),
                  decision: "UNDECIDED",
                  reason: ""
                }
              ]
            }
          ]
        }' \
        "$RUN_ROOT/logs/auto-command-surface.json" > "$RUN_ROOT/autodev-command-selection.json" || true
    fi

    {
      echo "# Autodev Command Selection"
      echo
      echo "Run: \`$RUN_ID\`"
      echo "Repo: \`$REPO_SLUG\`"
      echo
      if [[ -s "$RUN_ROOT/autodev-command-selection.json" ]]; then
        echo "Structured ledger: \`$RUN_ROOT/autodev-command-selection.json\`"
        echo
      fi
      echo "Every command, action, and subcommand discovered from the live \`auto\`"
      echo "surface must be marked \`selected\`, \`deferred\`, or \`skipped\`"
      echo "before implementation."
      echo "Inspect \`logs/auto-help-<command>.log\` for phase-specific options"
      echo "before choosing raw shell."
      echo "Replace every \`UNDECIDED\` value and include concrete evidence or a"
      echo "specific reason."
      echo
      echo "| Surface | Decision | Reason and Evidence |"
      echo "|---|---|---|"
      if [[ -s "$RUN_ROOT/autodev-command-selection.json" ]] && command -v jq >/dev/null 2>&1; then
        jq -r '
          def clean: (. // "" | gsub("\\|"; "/"));
          .commands[] as $cmd
          | "| `\($cmd.command)` | UNDECIDED | command: \(($cmd.about // "") | clean) |",
            ($cmd.actions[]? | "| `\(.command)` | UNDECIDED | action of `\($cmd.command)`: \((.help // "") | clean) |"),
            ($cmd.subcommands[]? as $sub
              | "| `\($sub.command)` | UNDECIDED | subcommand of `\($cmd.command)`: \(($sub.about // "") | clean) |",
                ($sub.subcommands[]? | "| `\(.command)` | UNDECIDED | subcommand of `\($sub.command)`: \((.about // "") | clean) |"))
        ' "$RUN_ROOT/autodev-command-selection.json"
      else
        while IFS= read -r cmd; do
          [[ -z "$cmd" ]] && continue
          printf '| `auto %s` | UNDECIDED |  |\n' "$cmd"
        done < "$RUN_ROOT/logs/auto-commands.txt"
      fi
    } > "$RUN_ROOT/autodev-command-selection.md"
  fi
  write_phase "command-surface" "ok" "inventoried auto command surface" "$RUN_ROOT/autodev-command-selection.md"
fi

run_logged() {
  local log_path="$1"
  shift
  (
    cd "$WORKDIR"
    set -o pipefail
    "$@" 2>&1 | tee "$log_path"
  )
}

run_phase_logged() {
  local phase="$1"
  local detail="$2"
  local log_path="$3"
  shift 3
  write_phase "$phase" "running" "$detail" "$log_path"
  if run_logged "$log_path" "$@"; then
    write_phase "$phase" "ok" "$detail" "$log_path"
    return 0
  else
    local status="$?"
    write_phase "$phase" "failed" "exit $status: $detail" "$log_path"
    return "$status"
  fi
}

EFFECTIVE_PLANNING_MODE="$PLANNING_MODE"
if [[ "$PLANNING_MODE" == "auto" ]]; then
  if [[ -f "$WORKDIR/IMPLEMENTATION_PLAN.md" || -f "$WORKDIR/WORKLIST.md" ]]; then
    EFFECTIVE_PLANNING_MODE="full"
  else
    EFFECTIVE_PLANNING_MODE="greenfield"
  fi
fi

echo "effective_planning_mode=$EFFECTIVE_PLANNING_MODE" >> "$RUN_ROOT/run.env"

if command -v auto >/dev/null 2>&1 && [[ -d "$WORKDIR/.git" ]]; then
  ORCHESTRATOR_DOCTOR_ARGS=(doctor --orchestrator --autodev-source "$AUTODEV_SOURCE")
  if [[ "$REMOTE_SYNC_MODE" == "local-no-origin" ]]; then
    ORCHESTRATOR_DOCTOR_ARGS+=(--allow-local-only)
  fi
  if [[ "$TYPED_PREFLIGHT_RAN" != "1" ]]; then
    run_phase_logged "orchestrator-doctor" "auto doctor --orchestrator" "$RUN_ROOT/orchestrator-doctor.log" auto "${ORCHESTRATOR_DOCTOR_ARGS[@]}"
    run_phase_logged "doctor" "auto doctor" "$RUN_ROOT/doctor.log" auto doctor
  fi

  if [[ "$TYPED_PLANNING_RAN" != "1" ]]; then
    if [[ "$REQUIRE_PLANNING_SPINE" == "1" && "$EFFECTIVE_PLANNING_MODE" != "none" ]]; then
      run_phase_logged "corpus" "auto corpus planning spine" "$RUN_ROOT/corpus.log" \
        auto corpus \
          --idea "$PROMPT" \
          --focus "$FOCUS" \
          --model "$MODEL" \
          --reasoning-effort "$PLAN_EFFORT" \
          --review-model "$MODEL" \
          --review-effort "$PLAN_EFFORT" \
          "${REFERENCE_ARGS[@]}"

      run_phase_logged "gen" "auto gen --snapshot-only planning spine" "$RUN_ROOT/gen.log" \
        auto gen \
          --snapshot-only \
          --model "$MODEL" \
          --reasoning-effort "$PLAN_EFFORT" \
          --review-model "$MODEL" \
          --review-effort "$PLAN_EFFORT"
    fi

    case "$EFFECTIVE_PLANNING_MODE" in
      greenfield)
        ;;
      steward|full)
        run_phase_logged "steward-preflight" "auto steward --report-only" "$RUN_ROOT/steward-preflight.log" \
          auto steward \
            --report-only \
            --output-dir "$RUN_ROOT/steward-preflight" \
            --model "$MODEL" \
            --reasoning-effort "$EFFORT" \
            --finalizer-model "$MODEL" \
            --finalizer-effort "$EFFORT" \
            "${REFERENCE_ARGS[@]}"
        ;;
      none)
        ;;
      *)
        echo "unsupported PILOT_PLANNING_MODE: $PLANNING_MODE" >&2
        exit 2
        ;;
    esac
  fi
fi

if [[ "$TYPED_PREFLIGHT_RAN" != "1" ]] && command -v gbrain >/dev/null 2>&1; then
  write_phase "gbrain-context" "running" "copy gbrain context pages" "$RUN_ROOT/gbrain"
  for slug in \
    manuals/canonical-development-operating-manual \
    manuals/hermes-codex-supervisor-workflow \
    manuals/hermes-orchestrator-development-memory \
    infrastructure/dev-orchestrator-machine-registry-2026-06-01 \
    infrastructure/dev-orchestrator-security-baseline-2026-06-01 \
    "projects/$REPO_SLUG"
  do
    safe_slug="${slug//\//__}"
    gbrain get "$slug" > "$RUN_ROOT/gbrain/$safe_slug.md" 2> "$RUN_ROOT/gbrain/$safe_slug.err" || true
  done
  write_phase "gbrain-context" "ok" "copied gbrain context pages" "$RUN_ROOT/gbrain"
fi

